# 이 파일은 이름만 적어 둔 예시입니다. 실제 값은 .env.local에 적으세요
# (.env.local은 git에 올리지 않습니다).

# --- 저장소 (lib/store, EPIC 1-3) ---

# memory: 인메모리 저장소(테스트 전용). upstash: Upstash Redis REST API
# (운영과 동일한 코드로 동작합니다). 비워두면 upstash가 기본값입니다.
STORE_DRIVER=upstash

# 로컬에서는 docker-compose.yml이 띄우는 serverless-redis-http
# (127.0.0.1:8079)를 가리킵니다. `npm run dev`/`npm run local`이 자동으로
# 켜 줍니다. 운영(Vercel)에서는 Upstash 콘솔의 REST URL로 바꿉니다.
UPSTASH_REDIS_REST_URL=http://localhost:8079

# docker-compose.yml의 SRH_TOKEN 기본값(local-dev-only-token)과 반드시
# 같아야 합니다. SRH_TOKEN을 바꿔 실행했다면 이 값도 그 값으로 맞추세요.
# 운영에서는 Upstash 콘솔에서 발급한 실제 토큰으로 바꿉니다.
UPSTASH_REDIS_REST_TOKEN=

# --- 접속 암호 (F13, EPIC 1-4) ---

# 팀 공용 접속 암호. 바꾸면 모든 기기의 로그인이 풀리고 다시 묻습니다.
# 비워 두면 서비스 전체가 막힙니다(암호 화면만 보이고 들어갈 수 없음).
ACCESS_PASSWORD=

# 쿠키 서명 키. 32자 이상이어야 하며, 짧거나 비어 있으면 서비스 전체가
# 막힙니다. 아래 명령으로 만든 값을 .env.local에만 적으세요:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 이 값을 바꿔도 모든 기기의 로그인이 풀립니다.
SESSION_SECRET=

# 쿠키를 보안 연결(https)로만 보낼지(Secure). 휴대폰으로 http:// 주소에
# 접속하는 로컬 환경에서는 false, 배포(Vercel, https)에서는 true.
COOKIE_SECURE=false

# 암호 5번 틀림 잠금을 셀 때 x-real-ip / x-forwarded-for 헤더를 믿을지.
# false(기본): 접속한 기기의 실제 주소로 셉니다(로컬·사내망). 헤더는 누구나
#   꾸며 보낼 수 있으므로 믿지 않습니다.
# true: 이 헤더를 덮어쓰는 프록시 뒤에서만 켭니다(Vercel). 프록시 없이 켜면
#   헤더를 바꿔 가며 잠금을 피할 수 있습니다.
TRUST_PROXY_HEADERS=false
