# 이 파일은 이름만 적어 둔 예시입니다. 실제 값은 .env.local에 적으세요
# (.env.local은 git에 올리지 않습니다).

# --- 저장소 (lib/store, EPIC 1-3) ---

# memory: 인메모리 저장소(테스트 전용). upstash: Upstash Redis REST API
# (운영과 동일한 코드로 동작합니다). 비워두면 upstash가 기본값입니다.
STORE_DRIVER=upstash

# 로컬에서는 docker-compose.yml이 띄우는 serverless-redis-http
# (127.0.0.1:8079)를 가리킵니다. `npm run dev`/`npm run local`이 자동으로
# 켜 줍니다. 운영(Vercel)에서는 Upstash 콘솔의 REST URL로 바꿉니다.
UPSTASH_REDIS_REST_URL=http://localhost:8079

# docker-compose.yml의 SRH_TOKEN 기본값(local-dev-only-token)과 반드시
# 같아야 합니다. SRH_TOKEN을 바꿔 실행했다면 이 값도 그 값으로 맞추세요.
# 운영에서는 Upstash 콘솔에서 발급한 실제 토큰으로 바꿉니다.
UPSTASH_REDIS_REST_TOKEN=

# (참고, 직접 적지 않아도 됨) Vercel에서 Upstash Redis를 프로젝트에
# 연결하면 KV_REST_API_URL / KV_REST_API_TOKEN이라는 이름으로 자동으로
# 채워집니다. 그 이름이 있으면 위 UPSTASH_REDIS_REST_URL/TOKEN 대신
# 그 값을 씁니다. 로컬에서는 몰라도 됩니다.

# 작업(회의록) 하나가 저장소에 남는 시간(초). 비워 두면 24시간(86400초,
# TRD 4장)입니다. 시험에서 만료 동작을 빨리 확인할 때만 짧게 바꿉니다.
JOB_TTL_SECONDS=

# --- 접속 암호 (F13, EPIC 1-4) ---

# 팀 공용 접속 암호. 바꾸면 모든 기기의 로그인이 풀리고 다시 묻습니다.
# 비워 두면 서비스 전체가 막힙니다(암호 화면만 보이고 들어갈 수 없음).
ACCESS_PASSWORD=

# 쿠키 서명 키. 32자 이상이어야 하며, 짧거나 비어 있으면 서비스 전체가
# 막힙니다. 아래 명령으로 만든 값을 .env.local에만 적으세요:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 이 값을 바꿔도 모든 기기의 로그인이 풀립니다.
SESSION_SECRET=

# 쿠키를 보안 연결(https)로만 보낼지(Secure). 휴대폰으로 http:// 주소에
# 접속하는 로컬 환경에서는 false, 배포(Vercel, https)에서는 true.
COOKIE_SECURE=false

# 암호 5번 틀림 잠금을 셀 때 x-real-ip / x-forwarded-for 헤더를 믿을지.
# false(기본): 접속한 기기의 실제 주소로 셉니다(로컬·사내망). 헤더는 누구나
#   꾸며 보낼 수 있으므로 믿지 않습니다.
# true: 이 헤더를 덮어쓰는 프록시 뒤에서만 켭니다(Vercel). 프록시 없이 켜면
#   헤더를 바꿔 가며 잠금을 피할 수 있습니다.
TRUST_PROXY_HEADERS=false

# --- 외부 연결: Gemini (EPIC 1-7, TRD T1·T2) ---

# fake(기본값, 비워 둬도 됨): 가짜 AI가 정해진 예시 회의록을 돌려줍니다
# (비용 없음, EPIC 3~4용). gemini: 실제 Gemini를 씁니다(EPIC 5부터, 비용
# 발생). 이 둘 말고 다른 값을 넣으면 처리가 오류로 멈춥니다.
AI_PROVIDER=fake

# Google AI Studio(https://aistudio.google.com/apikey)에서 만든 API 키.
# 결제를 연결한 프로젝트(유료 등급)의 키여야 합니다. AI_PROVIDER=fake일
# 때는 쓰지 않습니다.
GEMINI_API_KEY=

# 쓸 모델 이름. `npm run check:external`이 "모델을 쓸 수 없다"고 하면
# https://ai.google.dev/gemini-api/docs/models 에서 이름을 확인해 바꿉니다.
GEMINI_MODEL=gemini-3.8-flash

# --- 외부 연결: Gmail 발송 (EPIC 1-7, TRD T4) ---

# fake(기본값, 비워 둬도 됨): 가짜 메일 창구가 실제로 보내지 않고 성공한
# 것처럼 동작합니다(비용·오발송 위험 없음). smtp: 실제 Gmail로 보냅니다
# (EPIC 7부터).
MAIL_PROVIDER=fake

# 이 서비스 전용으로 만든 Gmail 주소.
GMAIL_USER=

# Gmail 로그인 비밀번호가 아니라 앱 비밀번호(16자)입니다. 전용 계정에서
# Google 계정 → 보안 → 2단계 인증을 켠 뒤 → 앱 비밀번호
# (https://myaccount.google.com/apppasswords)에서 만듭니다.
# Google이 보여 주는 대로 공백을 넣어 적어도 됩니다.
GMAIL_APP_PASSWORD=

# 메일의 보내는 사람 이름.
MAIL_FROM_NAME=회의록 봇

# `npm run check:external`의 시험 메일을 받을 주소. 비워 두면 GMAIL_USER로
# 보냅니다(내 메일함에서 확인).
EXTERNAL_CHECK_TO=

# 시험용 안전장치입니다. 여기 적은 주소(쉼표로 구분, `*@회사도메인` 형태도
# 가능)로만 실제 메일이 나가고 그 밖의 주소는 막힙니다. 로컬·미리보기 배포에서
# 실수로 엉뚱한 사람에게 보내는 것을 막으려는 용도입니다(TRD 7장).
# 로컬에서 실제로 보내려면(MAIL_PROVIDER=smtp) 꼭 적어야 합니다. 비워 두면
# 아무에게도 보내지 않고, 결과 화면에 주소마다 "보내지 못함 (허용 목록이
# 비어 있어…)"으로 나옵니다. 미리보기 배포도 같습니다. 제한 없이 보내는 것은
# Vercel 운영 배포(VERCEL_ENV=production)뿐입니다. 가짜 메일(MAIL_PROVIDER=fake)은
# 실제로 나가지 않으므로 이 값과 상관없습니다.
MAIL_ALLOWLIST=

# --- 청소 예약 (F11, EPIC 9-1) ---

# 하루 1번(또는 사람이 직접) 도는 청소 API `GET /api/cron/cleanup`을
# 아무나 부르지 못하게 막는 비밀값입니다. 요청 헤더에
# `Authorization: Bearer <이 값>`이 없거나 틀리면 실행되지 않습니다.
# SESSION_SECRET과 같은 방식으로 32자 이상 무작위 값을 만들어 적습니다:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# --- 녹음 임시 보관 (lib/storage, EPIC 3-3, D5) ---

# 올린 녹음을 처리 전까지 잠깐 담아 두는 내 컴퓨터 폴더. 비워 두면
# `.local-data/uploads/`입니다(git에 올리지 않음). 배포 뒤에는 Vercel
# Blob으로 바뀌어 이 값을 쓰지 않습니다(EPIC 10).
UPLOAD_DIR=

# --- 처리 Workflow 실행 방식 (workflows/runner.ts, EPIC 3, D5) ---

# in-process로 적으면 큐 없이 서버 안에서 곧바로 처리를 진행합니다(시험,
# 또는 Workflow 큐를 띄우지 않고 화면만 빠르게 확인할 때). 비워 두면
# `npm run dev`/`npm run local`이 띄우는 Workflow 로컬 실행 모드를 씁니다.
# 자동 시험(Vitest)은 항상 in-process로 동작합니다.
WORKFLOW_RUNNER=

# (선택, 보통 안 바꿔도 됨) Workflow 로컬 실행 모드가 진행 기록을 JSON
# 파일로 남기는 폴더입니다. `workflow` 패키지가 직접 읽는 값이라 이름이
# 다르며, 비워 두면 `.workflow-data/`입니다(git에 올리지 않음).
WORKFLOW_LOCAL_DATA_DIR=

# 보통은 비워 두세요. `npm run dev`/`npm run local`이 서버를 켤 때마다
# `http://localhost:3000/_workflow/<무작위 값>`을 만들어 주는데, 이렇게 해야
# 로컬 Workflow 큐만 처리 진행 endpoint를 부를 수 있습니다(lib/auth/workflow-queue.ts,
# scripts/lib/workflow-queue-url.mjs). `next dev`/`next start`를 직접 띄워서
# 이 값이 없으면 처리가 멈춘 채로 끝나지 않습니다. Vercel에서는 쓰지 않습니다.
WORKFLOW_LOCAL_BASE_URL=
