{
  "name": "meeting",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "local": "node scripts/local.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:store-local": "node scripts/test-store-local.mjs",
    "test:e2e": "playwright test",
    "check:fast": "npm run lint && npm run typecheck && npm run test:unit",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:e2e",
    "check:external": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-external/main.ts",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@upstash/redis": "^1.39.0",
    "music-metadata": "^11.16.1",
    "next": "16.3.6",
    "nodemailer": "^10.0.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/env": "16.3.6",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "simple-git-hooks": "2.14.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run check:fast"
  }
}
